    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.1",
    "@types/node": "^24.19.2",
    "@verdaccio/e2e-cli": "4.0.1",
    "@verdaccio/plugin-verifier": "1.0.0-next-9.37",
    "@verdaccio/types": "14.0.0-next-9.18",
    "azurite": "3.37.0",
    "rimraf": "~6.0.1",
    "typescript": "~5.9.3",
    "verdaccio": "7.0.2",
    "verdaccio-az-storage": "link:",
    "vitest": "5.0.5"
  },
  "scripts": {
    "build": "rimraf ./lib && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm build && vitest run",
    "test:e2e": "pnpm build && vitest run --config vitest.e2e.config.mts"
  },
  "files": [
    "/lib"
  ],
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad"
