{
  "name": "verdaccio-az-storage",
  "version": "2.0.0",
  "description": "Azure Storage plugin for Verdaccio",
  "license": "MIT",
  "author": {
    "name": "Voltstro",
    "email": "me@voltstro.dev"
  },
  "homepage": "https://github.com/Voltstro/verdaccio-az-storage",
